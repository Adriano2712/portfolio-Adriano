---
// Analytics sem cookies (docs/adr/0005-analytics.md). Só carrega em produção e com as variáveis definidas na Vercel:
//   PUBLIC_UMAMI_WEBSITE_ID  id do site no Umami
//   PUBLIC_UMAMI_SRC         URL do script (o Umami mostra ao criar o site)
const id = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const src = import.meta.env.PUBLIC_UMAMI_SRC;
const enabled = import.meta.env.PROD && id && src;
---
{enabled && <script is:inline defer src={src} data-website-id={id} data-do-not-track="true"></script>}
