---
// Alterna entre modo claro e escuro. Sem escolha salva, o site segue o sistema.
import { t } from '../i18n/utils';
import type { Locale } from '../data/facts';

interface Props { lang: Locale }
const { lang } = Astro.props;
---
<button type="button" data-theme-toggle
  data-label-light={t(lang, 'theme.toLight')} data-label-dark={t(lang, 'theme.toDark')}
  aria-label={t(lang, 'theme.toLight')} title={t(lang, 'theme.toLight')}
  class="theme-toggle flex size-11 items-center justify-center rounded-md border border-border text-text hover:bg-surface-2">
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
</button>

<style>
  /* Mostra o ícone do tema para o qual o botão leva. */
  .icon-moon { display: none; }
  :global(:root[data-theme='light']) .icon-sun { display: none; }
  :global(:root[data-theme='light']) .icon-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .icon-sun { display: none; }
    :global(:root:not([data-theme='dark'])) .icon-moon { display: block; }
  }
</style>

<script>
  const root = document.documentElement;
  const prefersLight = window.matchMedia('(prefers-color-scheme: light)');
  const current = () => (root.dataset.theme ?? (prefersLight.matches ? 'light' : 'dark')) as 'light' | 'dark';

  function sync() {
    const next = current() === 'dark' ? 'light' : 'dark';
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const label = next === 'light' ? btn.dataset.labelLight : btn.dataset.labelDark;
      if (label) { btn.setAttribute('aria-label', label); btn.title = label; }
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch { /* navegação privada: vale só nesta página */ }
      sync();
    });
  }
  prefersLight.addEventListener('change', sync);
  sync();
</script>
