---
// Diagrama pré-gerado (npm run diagrams). "Ampliar" abre em tela cheia (ZoomDialog).
import { currentProject, slugOf } from '../../lib/project';
import { getLangFromUrl, t } from '../../i18n/utils';
import Icon from '../Icon.astro';

interface Props { id: string }
const { id } = Astro.props;
const entry = await currentProject(Astro.url);
const lang = getLangFromUrl(Astro.url);
const slug = slugOf(entry);
const svgs = import.meta.glob<string>('../../content/projects/*/diagrams/*.svg', { query: '?raw', import: 'default', eager: true });
const key = `../../content/projects/${slug}/diagrams/${id}.${lang}.svg`;
const svg = svgs[key];
if (!svg) throw new Error(`Diagrama não gerado: ${key}. Rode "npm run diagrams".`);
const caption = entry.data.diagrams.find((d) => d.id === id)?.caption ?? '';
// O SVG vira imagem acessível: o texto alternativo é a legenda.
const accessibleSvg = svg.replace(/^<!--[\s\S]*?-->\s*/, '').replace('<svg ', `<svg role="img" aria-label="${caption.replaceAll('"', '&quot;')}" `);
---
<figure class="not-prose my-6 overflow-hidden rounded-lg border border-border bg-surface">
  <div class="overflow-x-auto p-4 md:p-6" tabindex="0" aria-label={caption}>
    <div class="diagram min-w-[600px] md:min-w-0" set:html={accessibleSvg} />
  </div>
  <figcaption class="flex items-center justify-between gap-3 border-t border-border px-4 py-2 text-sm text-muted md:px-6">
    <span>{caption}</span>
    <button type="button" data-zoom-svg={caption} class="flex min-h-11 min-w-11 flex-none items-center justify-center gap-2 rounded-md border border-border bg-bg px-3 text-text">
      <Icon name="maximize" /><span class="sr-only">{t(lang, 'case.zoomDiagram')}</span>
    </button>
  </figcaption>
</figure>
