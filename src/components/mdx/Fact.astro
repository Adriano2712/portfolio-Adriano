---
// Único jeito de um número aparecer no texto dos estudos de caso (ver src/data/facts.ts).
import { facts, type FactKey } from '../../data/facts';
import { getLangFromUrl } from '../../i18n/utils';

interface Props { k: FactKey }
const { k } = Astro.props;
if (!(k in facts)) throw new Error(`<Fact k="${k}"> não existe em src/data/facts.ts`);
const lang = getLangFromUrl(Astro.url);
---
<span class="fact">{facts[k][lang]}</span>
