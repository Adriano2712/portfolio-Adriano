---
import { currentProject } from '../../lib/project';
import { repos } from '../../data/facts';
import { t, getLangFromUrl } from '../../i18n/utils';
import Icon from '../Icon.astro';

const entry = await currentProject(Astro.url);
const lang = getLangFromUrl(Astro.url);
const href = entry.data.repo ? repos[entry.data.repo as keyof typeof repos] : undefined;
---
{href && (
  <a href={href} class="!mt-4 inline-flex min-h-12 items-center gap-2 rounded-md bg-accent px-5 font-semibold text-on-accent !no-underline">
    <Icon name="github" size={18} />{t(lang, 'case.codeOnGithub')}
  </a>
)}
