---
import { currentProject } from '../../lib/project';
import Chip from '../Chip.astro';
import { t, getLangFromUrl } from '../../i18n/utils';

const entry = await currentProject(Astro.url);
const lang = getLangFromUrl(Astro.url);
---
<ul aria-label="Stack" class="!mt-4 flex !list-none flex-wrap gap-2 !pl-0">
  {entry.data.stack.map((s) => <li class="!mt-0"><Chip>{s}</Chip></li>)}
</ul>
<span class="sr-only">{t(lang, 'case.stack')}</span>
