---
import CasePage from '../../../components/pages/CasePage.astro';
import { getProjects, slugOf, type Project } from '../../../lib/project';

export async function getStaticPaths() {
  const entries = await getProjects('en');
  return entries.map((entry: Project) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CasePage entry={entry} lang="en" />
